# ==========================================================================
#  Enterprise WAN Architect — variables de entorno
#  1) Copie este archivo:   cp .env.example .env
#  2) Complete los valores en .env (NUNCA en .env.example)
#  3) .env está en .gitignore: no se sube al repositorio
# ==========================================================================

# Credenciales por defecto para la consola NetDevOps (Módulo 5)
NET_USERNAME=netadmin
NET_PASSWORD=

# Seguridad de transporte
# false = solo se aceptan equipos cuya clave esté en ~/.ssh/known_hosts
ALLOW_UNKNOWN_HOSTS=false
# Telnet solo para laboratorios locales (GNS3/EVE-NG/eNSP), nunca producción
ENABLE_TELNET_LAB=false

# Secretos para sustituir los marcadores <<...>> al desplegar (opcional)
ADMIN_SECRET=
ENABLE_SECRET=
VPN_PSK=
SNMPV3_AUTH=
SNMPV3_PRIV=
